# Reproducible vector checksums on Windows and Linux.
*.vhd text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tcl text eol=lf
tb/vectors/*.txt text eol=lf

# Preserve archived measurement bytes, including vendor report formatting.
results/verification/traces/*.csv -text
# Preserve CSV-writer line endings and accept standard CRLF CSV records.
results/analysis/*.csv -text whitespace=cr-at-eol

# Preserve native editable presentation packages and PDF previews.
docs/presentations/*.pptx binary
docs/presentations/*.pdf binary
